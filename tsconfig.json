{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@utils/*": ["./src/utils/*.ts"],
      "@config/*": ["./src/config/*.ts"],
      "@types/*": ["./src/types/*.ts"],
      "@api/*": ["./src/api/*.ts"],
      "@constants/*": ["./src/constants/*.ts"],
      "@tests-data/*": ["./src/tests-data/*.ts"]
    }
  },

  "include": ["src/**/*.ts"]
}
